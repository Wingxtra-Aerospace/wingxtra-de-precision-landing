[Unit]
Description=Wingxtra Precision Landing
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wingxtra-pl
Group=wingxtra-pl
WorkingDirectory=/opt/wingxtra-de-precision-landing
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/wingxtra-de-precision-landing/scripts/run.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wingxtra-precision-landing
PrivateTmp=true

[Install]
WantedBy=multi-user.target
